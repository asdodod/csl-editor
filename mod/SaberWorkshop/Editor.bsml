              <text text="Section" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
              <dropdown-list-setting text="" id="section-list" choices="SectionOptions" value="SectionChoice" apply-on-change="true" preferred-height="6.4" preferred-width="44" />
            </vertical>
            <horizontal preferred-height="7" spacing="2" child-control-width="true" child-control-height="true" child-expand-width="false">
