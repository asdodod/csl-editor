<vertical preferred-width="250" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" anchor-min="0 0" anchor-max="1 1" size-delta="0 0" horizontal-fit="Unconstrained" pad-top="1" pad-bottom="1" vertical-fit="Unconstrained" pivot="0.5 0.5" anchored-position="0 0">
  <horizontal preferred-width="250" preferred-height="12" spacing="1" child-control-width="true" child-control-height="true" child-expand-width="false">
    <string-setting text="Preset" value="ProjectName" apply-on-change="true" bind-value="true" preferred-width="52" preferred-height="10" />
    <button text="Save" on-click="Save" preferred-width="22" preferred-height="9" />
    <button text="Export CSL" on-click="ExportCSL" preferred-width="30" preferred-height="9" />
    <button text="Undo" on-click="Undo" preferred-width="20" preferred-height="9" />
    <button text="Redo" on-click="Redo" preferred-width="20" preferred-height="9" />
    <button text="Reset panel" on-click="RecenterWall" preferred-width="32" preferred-height="9" />
    <button text="Close" on-click="CloseEditor" preferred-width="24" preferred-height="9" />
    <bool-setting text="Use in game" value="PlayEnabled" apply-on-change="true" bind-value="true" preferred-width="43" preferred-height="9" />
  </horizontal>
  <horizontal preferred-width="250" preferred-height="104" spacing="2.5" child-control-width="true" child-control-height="true" child-expand-width="false">
    <vertical preferred-width="54" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" preferred-height="104" child-alignment="UpperCenter">
      <text text="PROJECT / PARTS" font-size="3.2" align="Center" preferred-width="54" preferred-height="5" word-wrapping="false" />
      <scroll-view preferred-width="54" preferred-height="43">
        <vertical preferred-width="50" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" vertical-fit="PreferredSize" horizontal-fit="Unconstrained">
          <string-setting text="New name" value="NewPresetName" apply-on-change="true" bind-value="true" preferred-width="50" preferred-height="10" />
          <dropdown-list-setting text="Start with" value="StarterChoice" apply-on-change="true" bind-value="true" preferred-width="50" preferred-height="10" choices="StarterOptions" />
          <button text="Create preset" on-click="CreatePreset" preferred-width="50" preferred-height="7" />
          <dropdown-list-setting text="Saved preset" value="ProjectChoice" apply-on-change="true" bind-value="true" preferred-width="50" preferred-height="10" choices="ProjectOptions" id="project-list" />
          <horizontal preferred-width="50" preferred-height="7" spacing="2" child-control-width="true" child-control-height="true" child-expand-width="false">
            <button text="Open" on-click="OpenProject" preferred-width="24.0" preferred-height="7" />
            <button text="Save copy" on-click="SaveCopy" preferred-width="24.0" preferred-height="7" />
          </horizontal>
        </vertical>
      </scroll-view>
      <list id="part-tree" list-style="Simple" select-cell="SelectTreePart" list-width="54" visible-cells="6" cell-size="5" show-scrollbar="true" preferred-height="30" />
      <horizontal preferred-width="54" preferred-height="7" spacing="2" child-control-width="true" child-control-height="true" child-expand-width="false">
        <button text="Show / hide" on-click="TogglePart" preferred-width="26.0" preferred-height="7" />
        <button text="Copy" on-click="DuplicatePart" preferred-width="26.0" preferred-height="7" />
      </horizontal>
      <horizontal preferred-width="54" preferred-height="7" spacing="2" child-control-width="true" child-control-height="true" child-expand-width="false">
        <button text="+ Blade" on-click="AddBlade" preferred-width="26.0" preferred-height="7" />
        <button text="+ Handle" on-click="AddHandle" preferred-width="26.0" preferred-height="7" />
      </horizontal>
      <horizontal preferred-width="54" preferred-height="7" spacing="2" child-control-width="true" child-control-height="true" child-expand-width="false">
        <button text="+ Outline" on-click="AddOutline" preferred-width="26.0" preferred-height="7" />
        <button text="Delete" on-click="DeletePart" preferred-width="26.0" preferred-height="7" />
      </horizontal>
    </vertical>
    <vertical preferred-width="52" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" preferred-height="104" child-alignment="UpperCenter">
      <text text="SHAPE" font-size="3.2" align="Center" preferred-width="52" preferred-height="5" word-wrapping="false" />
      <scroll-view preferred-width="52" preferred-height="97">
        <vertical preferred-width="48" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" vertical-fit="PreferredSize" horizontal-fit="Unconstrained">
          <string-setting text="Part name" value="PartName" apply-on-change="true" bind-value="true" preferred-width="50" preferred-height="10" />
          <horizontal preferred-width="44" preferred-height="7" spacing="2" child-control-width="true" child-control-height="true" child-expand-width="false">
            <button text="+ Ring" on-click="AddRing" preferred-width="21.0" preferred-height="7" />
            <button text="+ Profile" on-click="AddProfile" preferred-width="21.0" preferred-height="7" />
          </horizontal>
          <horizontal preferred-width="44" preferred-height="7" spacing="2" child-control-width="true" child-control-height="true" child-expand-width="false">
            <button text="+ Inner" on-click="AddInner" preferred-width="44.0" preferred-height="7" />
          </horizontal>
          <vertical active="~IsCreatedPart" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" vertical-fit="PreferredSize" horizontal-fit="Unconstrained" preferred-width="48">
            <bool-setting text="Inverted faces" value="InvertedFaces" apply-on-change="true" bind-value="true" preferred-width="50" preferred-height="10" />
            <increment-setting text="Outline · mm" value="OutlineWidth" apply-on-change="true" bind-value="true" preferred-width="50" preferred-height="10" min="0" max="50" increment="0.1" />
          </vertical>
          <bool-setting text="Link hands" value="LinkHands" apply-on-change="true" preferred-height="7" preferred-width="44" />
          <bool-setting text="Visible" value="PartVisible" apply-on-change="true" preferred-height="7" preferred-width="44" />
          <increment-setting text="X · mm" value="PositionX" min="-1000" max="1000" increment="1" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
          <increment-setting text="Y · mm" value="PositionY" min="-1000" max="1000" increment="1" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
          <increment-setting text="Z · mm" value="PositionZ" min="-1000" max="2000" increment="1" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
          <increment-setting text="Rotate X" value="RotationX" min="-360" max="360" increment="1" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
          <increment-setting text="Rotate Y" value="RotationY" min="-360" max="360" increment="1" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
          <increment-setting text="Rotate Z" value="RotationZ" min="-360" max="360" increment="1" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
          <vertical active="~IsProfile" preferred-width="48" child-control-height="true" child-control-width="true" spacing="1" child-expand-height="false" vertical-fit="PreferredSize" horizontal-fit="Unconstrained">
            <increment-setting text="Length · mm" value="PartLength" min="1" max="2000" increment="1" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
            <dropdown-list-setting text="Section" id="section-list" choices="SectionOptions" value="SectionChoice" apply-on-change="true" preferred-height="10" preferred-width="44" />
            <horizontal preferred-height="7" spacing="2" child-control-width="true" child-control-height="true" child-expand-width="false">
              <button text="Add section" on-click="AddSection" preferred-width="21.0" preferred-height="7" />
              <button text="Remove section" on-click="DeleteSection" preferred-width="21.0" preferred-height="7" />
            </horizontal>
            <slider-setting text="Length · %" value="SectionPosition" min="0" max="100" increment="1" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
            <increment-setting text="Radius · mm" value="SectionRadius" min="0" max="300" increment="0.1" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
            <increment-setting text="Section X" value="SectionX" min="-300" max="300" increment="0.1" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
            <increment-setting text="Section Y" value="SectionY" min="-300" max="300" increment="0.1" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
            <increment-setting text="Sides" value="Sides" min="3" max="128" increment="1" integer-only="true" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
            <button text="Delete part" on-click="DeletePart" preferred-height="7" preferred-width="52" />
          </vertical>
        </vertical>
      </scroll-view>
    </vertical>
    <vertical preferred-width="30" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" preferred-height="104" child-alignment="UpperCenter">
      <text text="PREVIEW" font-size="3.2" align="Center" preferred-width="30" preferred-height="5" word-wrapping="false" />
      <bool-setting text="FBX guide" value="ShowSizeGuide" apply-on-change="true" bind-value="true" preferred-width="30" preferred-height="10" />
    </vertical>
    <vertical preferred-width="52" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" preferred-height="104" child-alignment="UpperCenter">
      <text text="MATERIAL" font-size="3.2" align="Center" preferred-width="52" preferred-height="5" word-wrapping="false" />
      <scroll-view preferred-width="52" preferred-height="97">
        <vertical preferred-width="48" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" vertical-fit="PreferredSize" horizontal-fit="Unconstrained">
          <dropdown-list-setting text="Layer" id="material-list" choices="MaterialOptions" value="MaterialChoice" apply-on-change="true" preferred-height="10" preferred-width="44" />
          <vertical child-control-height="true" child-control-width="true" child-expand-height="false" vertical-fit="PreferredSize" horizontal-fit="Unconstrained" spacing="1">
            <color-setting text="Color" value="TintColor" active="~HasTint" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
            <slider-setting text="Glow" value="Glow" active="~HasGlow" min="0" max="10" increment="0.1" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
          </vertical>
          <dropdown-list-setting text="Shader" id="shader-list" choices="ShaderOptions" value="ShaderChoice" apply-on-change="true" preferred-height="10" preferred-width="44" />
          <horizontal preferred-height="7" spacing="2" child-control-width="true" child-control-height="true" child-expand-width="false">
            <button text="New material" on-click="CreateMaterial" preferred-width="21.0" preferred-height="7" />
            <button text="Duplicate" on-click="DuplicateMaterial" preferred-width="21.0" preferred-height="7" />
          </horizontal>
          <button text="Apply shader" on-click="ApplyShader" preferred-height="7" preferred-width="52" />
          <bool-setting text="Advanced" value="Advanced" apply-on-change="true" preferred-height="7" preferred-width="44" />
          <string-setting text="Name" value="MaterialName" apply-on-change="true" bind-value="true" preferred-width="44" preferred-height="10" />
          <bool-setting text="Player color" value="PlayerColor" apply-on-change="true" bind-value="true" preferred-width="44" preferred-height="7" />
          <vertical active="~Advanced" child-control-height="true" child-control-width="true" child-expand-height="false" vertical-fit="PreferredSize" horizontal-fit="Unconstrained" spacing="1">
            <dropdown-list-setting text="Property" id="property-list" choices="PropertyOptions" value="PropertyChoice" apply-on-change="true" preferred-height="10" preferred-width="44" />
            <vertical active="~IsNumber" preferred-width="48" child-control-height="true" child-control-width="true" spacing="1" child-expand-height="false" vertical-fit="PreferredSize" horizontal-fit="Unconstrained">
              <increment-setting text="Value" value="NumberValue" increment="0.01" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
            </vertical>
            <vertical active="~IsColor" preferred-width="48" child-control-height="true" child-control-width="true" spacing="1" child-expand-height="false" vertical-fit="PreferredSize" horizontal-fit="Unconstrained">
              <color-setting text="Color" value="ColorValue" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
              <increment-setting text="Brightness" value="ColorIntensity" min="0" max="32" increment="0.1" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
              <slider-setting text="Opacity" value="AlphaValue" min="0" max="1" increment="0.01" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
            </vertical>
            <vertical active="~IsVector" preferred-width="48" child-control-height="true" child-control-width="true" spacing="1" child-expand-height="false" vertical-fit="PreferredSize" horizontal-fit="Unconstrained">
              <increment-setting text="X / R" value="VectorX" increment="0.01" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
              <increment-setting text="Y / G" value="VectorY" increment="0.01" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
              <increment-setting text="Z / B" value="VectorZ" increment="0.01" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
              <increment-setting text="W / A" value="VectorW" increment="0.01" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
            </vertical>
          </vertical>
        </vertical>
      </scroll-view>
    </vertical>
    <vertical preferred-width="52" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" preferred-height="104" child-alignment="UpperCenter">
      <text text="TEXTURES / VIEW" font-size="3.2" align="Center" preferred-width="52" preferred-height="5" word-wrapping="false" />
      <scroll-view preferred-width="52" preferred-height="97">
        <vertical preferred-width="48" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" vertical-fit="PreferredSize" horizontal-fit="Unconstrained">
          <dropdown-list-setting text="Layer" id="texture-material-list" choices="MaterialOptions" value="MaterialChoice" apply-on-change="true" preferred-height="10" preferred-width="44" />
          <dropdown-list-setting text="Slot" id="texture-slot-list" choices="TextureSlotOptions" value="TextureSlotChoice" apply-on-change="true" preferred-height="10" preferred-width="44" />
          <button text="Refresh images" on-click="RefreshFiles" preferred-height="7" preferred-width="52" />
          <button text="Generate plasma" on-click="GeneratePlasma" preferred-height="7" preferred-width="52" />
          <dropdown-list-setting text="Image" id="texture-file-list" choices="TextureFileOptions" value="TextureFileChoice" apply-on-change="true" preferred-height="10" preferred-width="44" />
          <button text="Apply image" on-click="ApplyTexture" preferred-height="7" preferred-width="52" />
          <increment-setting text="Repeat X" value="TileX" increment="0.05" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
          <increment-setting text="Repeat Y" value="TileY" increment="0.05" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
          <increment-setting text="Offset X" value="OffsetX" increment="0.05" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
          <increment-setting text="Offset Y" value="OffsetY" increment="0.05" apply-on-change="true" bind-value="true" preferred-height="10" preferred-width="44" />
          <text text="PREVIEW" font-size="3.2" align="Center" preferred-width="52" preferred-height="5" word-wrapping="false" />
          <color-setting text="Left color" value="LeftColor" apply-on-change="true" preferred-height="10" preferred-width="44" />
          <color-setting text="Right color" value="RightColor" apply-on-change="true" preferred-height="10" preferred-width="44" />
          <bool-setting text="Show preview" value="PreviewVisible" apply-on-change="true" preferred-height="7" preferred-width="44" />
          <increment-setting text="View scale" value="PreviewScale" min="0.2" max="2" increment="0.1" apply-on-change="true" preferred-height="10" preferred-width="44" />
          <button text="Recenter preview" on-click="ShowPreview" preferred-height="7" preferred-width="52" />
          <slider-setting text="Length scale" value="SaberLength" min="0.1" max="3" increment="0.05" apply-on-change="true" bind-value="true" preferred-width="44" preferred-height="10" />
          <slider-setting text="Width scale" value="SaberWidth" min="0.1" max="3" increment="0.05" apply-on-change="true" bind-value="true" preferred-width="44" preferred-height="10" />
          <text text="IMPORT SABER" font-size="3" preferred-height="5" preferred-width="48" />
          <dropdown-list-setting text="Saber" id="source-list" choices="SourceOptions" value="SourceChoice" apply-on-change="true" preferred-height="10" preferred-width="54" />
          <button text="Open saber" on-click="OpenSource" preferred-width="48" preferred-height="7" />
          <button text="Refresh files" on-click="RefreshFiles" preferred-width="48" preferred-height="7" />
        </vertical>
      </scroll-view>
    </vertical>
  </horizontal>
  <text text="~Status" font-size="3" word-wrapping="false" overflow-mode="Ellipsis" align="Left" preferred-width="244" preferred-height="6" />
</vertical>
