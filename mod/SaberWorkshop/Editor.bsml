<vertical preferred-width="250" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" horizontal-fit="Unconstrained" anchor-min="0 0" anchor-max="1 1" size-delta="0 0" pivot="0.5 0.5" anchored-position="0 0" vertical-fit="Unconstrained" pad-top="1" pad-bottom="1">
  <horizontal preferred-width="250" preferred-height="12" spacing="2" child-control-width="true" child-control-height="true" child-expand-width="false">
    <button text="Create new preset" on-click="NewPresetDialog" preferred-width="35" preferred-height="9" />
    <vertical preferred-width="72" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" preferred-height="10">
      <text text="Preset" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="72" preferred-height="3.6" />
      <string-setting text="" value="ProjectName" apply-on-change="true" bind-value="true" preferred-width="72" preferred-height="6.4" />
    </vertical>
    <button text="Save" on-click="Save" preferred-width="25" preferred-height="9" />
    <button text="Export CSL" on-click="ExportCSL" preferred-width="34" preferred-height="9" />
    <button text="Undo" on-click="Undo" preferred-width="22" preferred-height="9" />
    <button text="Redo" on-click="Redo" preferred-width="22" preferred-height="9" />
    <button text="Close" on-click="CloseEditor" preferred-width="28" preferred-height="9" />
  </horizontal>
  <horizontal preferred-width="250" preferred-height="104" spacing="3" child-control-width="true" child-control-height="true" child-expand-width="false">
    <vertical preferred-width="58" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" horizontal-fit="Unconstrained" preferred-height="104">
      <text text="PRESETS" font-size="3.6" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="58" preferred-height="5" />
      <vertical preferred-width="54" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" preferred-height="10">
        <text text="Open saved preset" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="54" preferred-height="3.6" />
        <dropdown-list-setting text="" value="ProjectChoice" apply-on-change="true" bind-value="true" preferred-width="54" preferred-height="6.4" id="project-list" choices="ProjectOptions" />
      </vertical>
      <horizontal preferred-width="54" preferred-height="7" spacing="1" child-control-width="true" child-control-height="true" child-expand-width="false">
        <button text="Open" on-click="OpenProject" preferred-width="26.5" preferred-height="7" />
        <button text="Copy preset" on-click="SaveCopy" preferred-width="26.5" preferred-height="7" />
      </horizontal>
      <text text="PARTS" font-size="3.6" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="58" preferred-height="5" />
      <list id="part-tree" list-style="Simple" select-cell="SelectTreePart" list-width="58" visible-cells="8" cell-size="5" show-scrollbar="true" preferred-height="40" />
      <horizontal preferred-width="58" preferred-height="7" spacing="1" child-control-width="true" child-control-height="true" child-expand-width="false">
        <button text="Hide / show" on-click="TogglePart" preferred-width="28.5" preferred-height="7" />
        <button text="Duplicate" on-click="DuplicatePart" preferred-width="28.5" preferred-height="7" />
      </horizontal>
      <horizontal preferred-width="58" preferred-height="7" spacing="1" child-control-width="true" child-control-height="true" child-expand-width="false">
        <button text="+ Blade" on-click="AddBlade" preferred-width="28.5" preferred-height="7" />
        <button text="+ Handle" on-click="AddHandle" preferred-width="28.5" preferred-height="7" />
      </horizontal>
      <horizontal preferred-width="58" preferred-height="7" spacing="1" child-control-width="true" child-control-height="true" child-expand-width="false">
        <button text="+ Ring" on-click="AddRing" preferred-width="28.5" preferred-height="7" />
        <button text="+ Particles" on-click="AddParticles" preferred-width="28.5" preferred-height="7" />
      </horizontal>
      <horizontal preferred-width="58" preferred-height="7" spacing="1" child-control-width="true" child-control-height="true" child-expand-width="false">
        <button text="+ Trail" on-click="AddTrail" preferred-width="28.5" preferred-height="7" />
        <button text="Delete" on-click="DeletePart" preferred-width="28.5" preferred-height="7" />
      </horizontal>
    </vertical>
    <vertical preferred-width="104" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" horizontal-fit="Unconstrained" preferred-height="104">
      <horizontal preferred-width="104" preferred-height="8" spacing="1" child-control-width="true" child-control-height="true" child-expand-width="false">
        <button text="~ShapeTabLabel" on-click="InspectShape" preferred-width="25.25" preferred-height="8" />
        <button text="~ColorTabLabel" on-click="InspectColor" preferred-width="25.25" preferred-height="8" />
        <button text="~TextureTabLabel" on-click="InspectTexture" preferred-width="25.25" preferred-height="8" />
        <button text="~ShaderTabLabel" on-click="ShaderWorkshop" preferred-width="25.25" preferred-height="8" />
      </horizontal>
      <scroll-view preferred-width="104" preferred-height="94">
        <vertical preferred-width="96" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
          <vertical active="~HasSelection" child-control-height="true" child-control-width="true" child-expand-height="false" preferred-width="96" vertical-fit="PreferredSize" spacing="1">
            <vertical preferred-width="96" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" horizontal-fit="Unconstrained" active="~ShapeInspector" vertical-fit="PreferredSize">
              <vertical preferred-width="94" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" preferred-height="10">
                <text text="Selected part" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="94" preferred-height="3.6" />
                <string-setting text="" value="PartName" apply-on-change="true" bind-value="true" preferred-width="94" preferred-height="6.4" />
              </vertical>
              <text text="POSITION · mm" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="94" preferred-height="5" />
              <horizontal preferred-width="94" preferred-height="10" spacing="2" child-control-width="true" child-control-height="true" child-expand-width="false">
                <vertical preferred-width="30" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" preferred-height="10">
                  <text text="X" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="30" preferred-height="3.6" />
                  <increment-setting text="" value="PositionX" apply-on-change="true" bind-value="true" preferred-width="30" preferred-height="6.4" increment="1" min="-3000" max="3000" />
                </vertical>
                <vertical preferred-width="30" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" preferred-height="10">
                  <text text="Y" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="30" preferred-height="3.6" />
                  <increment-setting text="" value="PositionY" apply-on-change="true" bind-value="true" preferred-width="30" preferred-height="6.4" increment="1" min="-3000" max="3000" />
                </vertical>
                <vertical preferred-width="30" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" preferred-height="10">
                  <text text="Z" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="30" preferred-height="3.6" />
                  <increment-setting text="" value="PositionZ" apply-on-change="true" bind-value="true" preferred-width="30" preferred-height="6.4" increment="1" min="-3000" max="3000" />
                </vertical>
              </horizontal>
              <text text="ROTATION · degrees" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="94" preferred-height="5" />
              <horizontal preferred-width="94" preferred-height="10" spacing="2" child-control-width="true" child-control-height="true" child-expand-width="false">
                <vertical preferred-width="30" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" preferred-height="10">
                  <text text="X" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="30" preferred-height="3.6" />
                  <increment-setting text="" value="RotationX" apply-on-change="true" bind-value="true" preferred-width="30" preferred-height="6.4" increment="1" min="-3000" max="3000" />
                </vertical>
                <vertical preferred-width="30" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" preferred-height="10">
                  <text text="Y" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="30" preferred-height="3.6" />
                  <increment-setting text="" value="RotationY" apply-on-change="true" bind-value="true" preferred-width="30" preferred-height="6.4" increment="1" min="-3000" max="3000" />
                </vertical>
                <vertical preferred-width="30" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" preferred-height="10">
                  <text text="Z" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="30" preferred-height="3.6" />
                  <increment-setting text="" value="RotationZ" apply-on-change="true" bind-value="true" preferred-width="30" preferred-height="6.4" increment="1" min="-3000" max="3000" />
                </vertical>
              </horizontal>
              <horizontal preferred-width="94" preferred-height="6.4" child-control-width="true" child-control-height="true" child-expand-width="false">
                <text text="Visible" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="76" preferred-height="6.4" />
                <bool-setting text="" value="PartVisible" apply-on-change="true" bind-value="true" preferred-width="18" preferred-height="6.4" />
              </horizontal>
              <vertical preferred-width="94" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" horizontal-fit="Unconstrained" active="~IsSolidPart" vertical-fit="PreferredSize">
                <horizontal preferred-width="94" preferred-height="10" spacing="2" child-control-width="true" child-control-height="true" child-expand-width="false">
                  <vertical preferred-width="30" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" preferred-height="10">
                    <text text="Height · mm" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="30" preferred-height="3.6" />
                    <string-setting text="" value="PartHeightText" apply-on-change="true" bind-value="true" preferred-width="30" preferred-height="6.4" />
                  </vertical>
                  <vertical preferred-width="30" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" preferred-height="10">
                    <text text="Width · mm" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="30" preferred-height="3.6" />
                    <string-setting text="" value="PartWidthText" apply-on-change="true" bind-value="true" preferred-width="30" preferred-height="6.4" />
                  </vertical>
                  <vertical preferred-width="30" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" preferred-height="10">
                    <text text="Depth · mm" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="30" preferred-height="3.6" />
                    <string-setting text="" value="PartDepthText" apply-on-change="true" bind-value="true" preferred-width="30" preferred-height="6.4" />
                  </vertical>
                </horizontal>
                <horizontal preferred-width="94" preferred-height="6.4" child-control-width="true" child-control-height="true" child-expand-width="false">
                  <text text="Inverted faces" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="76" preferred-height="6.4" />
                  <bool-setting text="" value="InvertedFaces" apply-on-change="true" bind-value="true" preferred-width="18" preferred-height="6.4" />
                </horizontal>
                <horizontal preferred-width="94" preferred-height="7" spacing="1" child-control-width="true" child-control-height="true" child-expand-width="false">
                  <button text="Create outline pair" on-click="OutlinePair" preferred-width="46.5" preferred-height="7" />
                  <button text="Duplicate in place" on-click="DuplicatePart" preferred-width="46.5" preferred-height="7" />
                </horizontal>
                <vertical preferred-width="94" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" horizontal-fit="Unconstrained" active="~IsProfile" vertical-fit="PreferredSize">
                  <vertical preferred-width="94" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" vertical-fit="PreferredSize" spacing="0">
                    <text text="Cross section" font-size="3" preferred-height="3.6" word-wrapping="false" />
                    <dropdown-list-setting text="" value="CrossSection" choices="CrossSections" bind-value="true" apply-on-change="true" preferred-height="6.4" />
                  </vertical>
                  <horizontal preferred-width="94" preferred-height="6.4" child-control-width="true" child-control-height="true" child-expand-width="false">
                    <text text="Edit shape points" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="76" preferred-height="6.4" />
                    <bool-setting text="" value="ShowShapePoints" apply-on-change="true" bind-value="true" preferred-width="18" preferred-height="6.4" />
                  </horizontal>
                  <vertical preferred-width="94" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" horizontal-fit="Unconstrained" active="~ShowShapePoints" vertical-fit="PreferredSize">
                    <vertical preferred-width="92" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" preferred-height="10">
                      <text text="Shape point" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="92" preferred-height="3.6" />
                      <dropdown-list-setting text="" value="SectionChoice" apply-on-change="true" bind-value="true" preferred-width="92" preferred-height="6.4" id="section-list" choices="SectionOptions" />
                    </vertical>
                    <horizontal preferred-width="92" preferred-height="7" spacing="1" child-control-width="true" child-control-height="true" child-expand-width="false">
                      <button text="Add point" on-click="AddSection" preferred-width="45.5" preferred-height="7" />
                      <button text="Remove point" on-click="DeleteSection" preferred-width="45.5" preferred-height="7" />
                    </horizontal>
                    <vertical preferred-width="92" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" preferred-height="10">
                      <text text="Along height · %" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="92" preferred-height="3.6" />
                      <increment-setting text="" value="SectionPosition" apply-on-change="true" bind-value="true" preferred-width="92" preferred-height="6.4" increment="1" min="0" max="100" />
                    </vertical>
                    <vertical preferred-width="92" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" preferred-height="10">
                      <text text="Point width · mm" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="92" preferred-height="3.6" />
                      <increment-setting text="" value="PointWidth" apply-on-change="true" bind-value="true" preferred-width="92" preferred-height="6.4" increment="0.1" min="0.05" max="600" />
                    </vertical>
                    <vertical preferred-width="92" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" preferred-height="10">
                      <text text="Point depth · mm" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="92" preferred-height="3.6" />
                      <increment-setting text="" value="PointDepth" apply-on-change="true" bind-value="true" preferred-width="92" preferred-height="6.4" increment="0.1" min="0.05" max="600" />
                    </vertical>
                    <vertical preferred-width="92" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" preferred-height="10">
                      <text text="Offset X · mm" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="92" preferred-height="3.6" />
                      <increment-setting text="" value="SectionX" apply-on-change="true" bind-value="true" preferred-width="92" preferred-height="6.4" increment="0.1" min="-300" max="300" />
                    </vertical>
                    <vertical preferred-width="92" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" preferred-height="10">
                      <text text="Offset Y · mm" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="92" preferred-height="3.6" />
                      <increment-setting text="" value="SectionY" apply-on-change="true" bind-value="true" preferred-width="92" preferred-height="6.4" increment="0.1" min="-300" max="300" />
                    </vertical>
                  </vertical>
                </vertical>
              </vertical>
              <vertical preferred-width="94" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" horizontal-fit="Unconstrained" active="~IsParticle" vertical-fit="PreferredSize">
                <vertical preferred-width="92" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" preferred-height="10">
                  <text text="Particle example" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="92" preferred-height="3.6" />
