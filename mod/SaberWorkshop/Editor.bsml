    <vertical preferred-width="30" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" preferred-height="104" child-alignment="UpperCenter">
      <text text="PREVIEW" font-size="3.2" align="Center" preferred-width="30" preferred-height="5" word-wrapping="false" />
