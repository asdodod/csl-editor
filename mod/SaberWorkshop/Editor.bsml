            <vertical active="~IsColor" preferred-width="48" child-control-height="true" child-control-width="true" spacing="1" child-expand-height="false" vertical-fit="PreferredSize" horizontal-fit="Unconstrained">
              <vertical preferred-width="44.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
                <text text="Color" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
                <color-setting text="" value="ColorValue" apply-on-change="true" bind-value="true" preferred-height="6.4" preferred-width="44" />
              </vertical>
              <vertical preferred-width="44.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
                <text text="Brightness" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
                <increment-setting text="" value="ColorIntensity" min="0" max="32" increment="0.1" apply-on-change="true" bind-value="true" preferred-height="6.4" preferred-width="44" />
              </vertical>
              <vertical preferred-width="44.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
                <text text="Opacity" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
                <slider-setting text="" value="AlphaValue" min="0" max="1" increment="0.01" apply-on-change="true" bind-value="true" preferred-height="6.4" preferred-width="44" />
              </vertical>
            </vertical>
            <vertical active="~IsVector" preferred-width="48" child-control-height="true" child-control-width="true" spacing="1" child-expand-height="false" vertical-fit="PreferredSize" horizontal-fit="Unconstrained">
              <vertical preferred-width="44.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
                <text text="X / R" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
                <increment-setting text="" value="VectorX" increment="0.01" apply-on-change="true" bind-value="true" preferred-height="6.4" preferred-width="44" />
              </vertical>
              <vertical preferred-width="44.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
                <text text="Y / G" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
                <increment-setting text="" value="VectorY" increment="0.01" apply-on-change="true" bind-value="true" preferred-height="6.4" preferred-width="44" />
              </vertical>
              <vertical preferred-width="44.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
                <text text="Z / B" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
                <increment-setting text="" value="VectorZ" increment="0.01" apply-on-change="true" bind-value="true" preferred-height="6.4" preferred-width="44" />
              </vertical>
              <vertical preferred-width="44.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
                <text text="W / A" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
                <increment-setting text="" value="VectorW" increment="0.01" apply-on-change="true" bind-value="true" preferred-height="6.4" preferred-width="44" />
              </vertical>
            </vertical>
          </vertical>
        </vertical>
      </scroll-view>
    </vertical>
    <vertical preferred-width="52" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" preferred-height="104" child-alignment="UpperCenter">
      <text text="TEXTURES / VIEW" font-size="3.2" align="Center" preferred-width="52" preferred-height="5" word-wrapping="false" />
      <scroll-view preferred-width="52" preferred-height="97">
        <vertical preferred-width="48" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" vertical-fit="PreferredSize" horizontal-fit="Unconstrained">
          <vertical preferred-width="44.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
            <text text="Layer" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
            <dropdown-list-setting text="" id="texture-material-list" choices="MaterialOptions" value="MaterialChoice" apply-on-change="true" preferred-height="6.4" preferred-width="44" />
          </vertical>
          <vertical preferred-width="44.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
            <text text="Slot" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
            <dropdown-list-setting text="" id="texture-slot-list" choices="TextureSlotOptions" value="TextureSlotChoice" apply-on-change="true" preferred-height="6.4" preferred-width="44" />
          </vertical>
          <button text="Refresh images" on-click="RefreshFiles" preferred-height="7" preferred-width="52" />
          <button text="Generate plasma" on-click="GeneratePlasma" preferred-height="7" preferred-width="52" />
          <vertical preferred-width="44.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
            <text text="Image" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
            <dropdown-list-setting text="" id="texture-file-list" choices="TextureFileOptions" value="TextureFileChoice" apply-on-change="true" preferred-height="6.4" preferred-width="44" />
          </vertical>
          <button text="Apply image" on-click="ApplyTexture" preferred-height="7" preferred-width="52" />
          <vertical preferred-width="44.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
            <text text="Repeat X" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
            <increment-setting text="" value="TileX" increment="0.05" apply-on-change="true" bind-value="true" preferred-height="6.4" preferred-width="44" />
          </vertical>
          <vertical preferred-width="44.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
            <text text="Repeat Y" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
            <increment-setting text="" value="TileY" increment="0.05" apply-on-change="true" bind-value="true" preferred-height="6.4" preferred-width="44" />
          </vertical>
          <vertical preferred-width="44.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
            <text text="Offset X" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
            <increment-setting text="" value="OffsetX" increment="0.05" apply-on-change="true" bind-value="true" preferred-height="6.4" preferred-width="44" />
          </vertical>
          <vertical preferred-width="44.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
            <text text="Offset Y" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
            <increment-setting text="" value="OffsetY" increment="0.05" apply-on-change="true" bind-value="true" preferred-height="6.4" preferred-width="44" />
          </vertical>
          <text text="PREVIEW" font-size="3.2" align="Center" preferred-width="52" preferred-height="5" word-wrapping="false" />
          <vertical preferred-width="44.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
            <text text="Left color" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
            <color-setting text="" value="LeftColor" apply-on-change="true" preferred-height="6.4" preferred-width="44" />
          </vertical>
          <vertical preferred-width="44.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
            <text text="Right color" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
            <color-setting text="" value="RightColor" apply-on-change="true" preferred-height="6.4" preferred-width="44" />
          </vertical>
          <horizontal preferred-width="44.0" preferred-height="6.4" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" child-expand-width="false">
            <text text="Show preview" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="6.4" preferred-width="27.0" />
            <bool-setting text="" value="PreviewVisible" apply-on-change="true" preferred-height="6.4" preferred-width="17" />
          </horizontal>
          <vertical preferred-width="44.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
            <text text="View scale" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
            <increment-setting text="" value="PreviewScale" min="0.2" max="2" increment="0.1" apply-on-change="true" preferred-height="6.4" preferred-width="44" />
          </vertical>
          <button text="Recenter preview" on-click="ShowPreview" preferred-height="7" preferred-width="52" />
          <vertical preferred-width="44.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
            <text text="Length scale" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
            <slider-setting text="" value="SaberLength" min="0.1" max="3" increment="0.05" apply-on-change="true" bind-value="true" preferred-width="44" preferred-height="6.4" />
          </vertical>
          <vertical preferred-width="44.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
            <text text="Width scale" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
            <slider-setting text="" value="SaberWidth" min="0.1" max="3" increment="0.05" apply-on-change="true" bind-value="true" preferred-width="44" preferred-height="6.4" />
          </vertical>
          <text text="IMPORT SABER" font-size="3" preferred-height="5" preferred-width="48" />
          <vertical preferred-width="54.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
            <text text="Saber" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="54.0" />
            <dropdown-list-setting text="" id="source-list" choices="SourceOptions" value="SourceChoice" apply-on-change="true" preferred-height="6.4" preferred-width="54" />
          </vertical>
          <button text="Open saber" on-click="OpenSource" preferred-width="48" preferred-height="7" />
          <button text="Refresh files" on-click="RefreshFiles" preferred-width="48" preferred-height="7" />
        </vertical>
      </scroll-view>
    </vertical>
  </horizontal>
  <text text="~Status" font-size="3" word-wrapping="false" overflow-mode="Ellipsis" align="Left" preferred-width="244" preferred-height="6" />
</vertical>
