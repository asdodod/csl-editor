                </vertical>
                <vertical preferred-width="92" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" preferred-height="10">
                  <text text="Particles / second" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="92" preferred-height="3.6" />
                  <increment-setting text="" value="ParticleRate" apply-on-change="true" bind-value="true" preferred-width="92" preferred-height="6.4" increment="1" min="0" max="500" />
                </vertical>
                <vertical preferred-width="92" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" preferred-height="10">
                  <text text="Lifetime · seconds" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="92" preferred-height="3.6" />
                  <increment-setting text="" value="ParticleLife" apply-on-change="true" bind-value="true" preferred-width="92" preferred-height="6.4" increment="0.05" min="0.05" max="10" />
                </vertical>
                <vertical preferred-width="92" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" preferred-height="10">
                  <text text="Speed · m/s" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="92" preferred-height="3.6" />
                  <increment-setting text="" value="ParticleSpeed" apply-on-change="true" bind-value="true" preferred-width="92" preferred-height="6.4" increment="0.01" min="0" max="5" />
                </vertical>
                <vertical preferred-width="92" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" preferred-height="10">
                  <text text="Size · mm" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="92" preferred-height="3.6" />
                  <increment-setting text="" value="ParticleSize" apply-on-change="true" bind-value="true" preferred-width="92" preferred-height="6.4" increment="0.1" min="0.1" max="100" />
