                  <text text="Spread · degrees" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="92" preferred-height="3.6" />
                  <increment-setting text="" value="ParticleSpread" apply-on-change="true" bind-value="true" preferred-width="92" preferred-height="6.4" increment="1" min="0" max="90" />
                </vertical>
              </vertical>
              <vertical preferred-width="94" child-control-height="true" child-control-width="true" child-expand-height="false" vertical-fit="PreferredSize" spacing="1" active="~IsTrail">
                <vertical preferred-width="92" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" vertical-fit="PreferredSize" spacing="0">
                  <text text="Trail type" preferred-height="3.6" font-size="3" word-wrapping="false" />
                  <dropdown-list-setting text="" value="TrailType" bind-value="true" apply-on-change="true" preferred-height="6.4" preferred-width="92" choices="TrailTypes" />
                </vertical>
                <vertical preferred-width="92" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" vertical-fit="PreferredSize" spacing="0">
                  <text text="Start with" preferred-height="3.6" font-size="3" word-wrapping="false" />
                  <dropdown-list-setting text="" value="TrailPreset" bind-value="true" apply-on-change="true" preferred-height="6.4" preferred-width="92" choices="TrailPresets" />
                </vertical>
                <vertical preferred-width="92" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" vertical-fit="PreferredSize" spacing="0">
                  <text text="Width · mm" preferred-height="3.6" font-size="3" word-wrapping="false" />
                  <string-setting text="" value="TrailWidthText" bind-value="true" apply-on-change="true" preferred-height="6.4" preferred-width="92" />
                </vertical>
                <vertical preferred-width="92" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" vertical-fit="PreferredSize" spacing="0">
                  <text text="Fade time · ms" preferred-height="3.6" font-size="3" word-wrapping="false" />
                  <increment-setting text="" value="TrailTime" bind-value="true" apply-on-change="true" preferred-height="6.4" preferred-width="92" increment="10" min="20" max="2000" />
                </vertical>
                <vertical preferred-width="92" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" vertical-fit="PreferredSize" spacing="0">
                  <text text="Tail width · %" preferred-height="3.6" font-size="3" word-wrapping="false" />
                  <increment-setting text="" value="TrailTaper" bind-value="true" apply-on-change="true" preferred-height="6.4" preferred-width="92" increment="5" min="0" max="100" />
                </vertical>
                <text text="100%: same width. 0%: ends in a point." font-size="2.8" preferred-height="5" preferred-width="92" word-wrapping="false" />
                <text text="Use Colour to tint it. A texture is optional." font-size="2.8" preferred-height="5" preferred-width="92" word-wrapping="false" />
              </vertical>
            </vertical>
            <vertical preferred-width="96" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" horizontal-fit="Unconstrained" active="~ColorInspector" vertical-fit="PreferredSize">
              <vertical preferred-width="92" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" preferred-height="10">
                <text text="Material layer" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="92" preferred-height="3.6" />
