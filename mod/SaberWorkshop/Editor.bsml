            </vertical>
          </vertical>
          <text active="~NoSelection" text="Add a part on the left to start modelling." font-size="3.4" preferred-height="12" preferred-width="94" word-wrapping="true" />
        </vertical>
      </scroll-view>
    </vertical>
    <vertical preferred-width="82" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" horizontal-fit="Unconstrained" preferred-height="104">
      <text text="PREVIEW" font-size="3.8" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="82" preferred-height="5" />
      <vertical preferred-height="60" min-height="60" preferred-width="82" child-control-height="true" child-control-width="true" child-expand-height="false" />
      <horizontal preferred-width="80" preferred-height="6.4" child-control-height="true" child-control-width="true" child-expand-width="false">
        <text text="FBX sizing guide" preferred-width="62" preferred-height="6.4" font-size="3.4" word-wrapping="false" />
        <bool-setting text="" value="ShowSizeGuide" apply-on-change="true" bind-value="true" preferred-width="18" preferred-height="6.4" />
      </horizontal>
      <horizontal preferred-width="80" preferred-height="6.4" child-control-height="true" child-control-width="true" child-expand-width="false">
        <text text="Use preset in game" preferred-width="62" preferred-height="6.4" font-size="3.4" word-wrapping="false" />
        <bool-setting text="" value="PlayEnabled" apply-on-change="true" bind-value="true" preferred-width="18" preferred-height="6.4" />
      </horizontal>
      <horizontal preferred-width="80" preferred-height="6.4" child-control-height="true" child-control-width="true" child-expand-width="false">
        <text text="Test swing" preferred-width="62" preferred-height="6.4" font-size="3.4" word-wrapping="false" />
        <bool-setting text="" value="TestSwing" bind-value="true" apply-on-change="true" preferred-width="18" preferred-height="6.4" />
      </horizontal>
      <button text="Fit preview" on-click="ShowPreview" preferred-width="80" preferred-height="7" />
    </vertical>
  </horizontal>
  <text text="~Status" font-size="3.4" align="Left" word-wrapping="false" overflow-mode="Ellipsis" preferred-width="244" preferred-height="6" />
  <modal id="preset-dialog" size-delta="90 78" click-off-closes="false" move-to-center="false">
    <vertical preferred-width="88" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" horizontal-fit="Unconstrained" pad="3">
      <text text="CREATE NEW PRESET" font-size="4" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="82" preferred-height="7" />
      <horizontal preferred-width="80" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="2" horizontal-fit="Unconstrained" vertical-fit="Unconstrained" preferred-height="8" child-expand-width="false">
        <text text="Name" font-size="3.4" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="30" preferred-height="8" />
        <string-setting text="" value="NewPresetName" apply-on-change="true" bind-value="true" preferred-width="48.0" preferred-height="8" />
      </horizontal>
      <horizontal preferred-width="80" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="2" horizontal-fit="Unconstrained" vertical-fit="Unconstrained" preferred-height="8" child-expand-width="false">
        <text text="Start with" font-size="3.4" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="30" preferred-height="8" />
        <dropdown-list-setting text="" value="StarterChoice" apply-on-change="true" bind-value="true" preferred-width="48.0" preferred-height="8" choices="StarterOptions" />
      </horizontal>
      <horizontal preferred-width="80" preferred-height="7" spacing="1" child-control-width="true" child-control-height="true" child-expand-width="false">
        <button text="Create" on-click="CreatePreset" preferred-width="39.5" preferred-height="7" />
        <button text="Cancel" on-click="ClosePresetDialog" preferred-width="39.5" preferred-height="7" />
      </horizontal>
      <text text="A unique filename protects existing presets." font-size="3.4" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="80" preferred-height="5" />
    </vertical>
  </modal>
  <modal id="library-dialog" size-delta="102 84" click-off-closes="false" move-to-center="false">
    <vertical preferred-width="98" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" pad="3">
      <text text="OPEN PRESET" preferred-width="92" preferred-height="7" font-size="4.5" word-wrapping="false" overflow-mode="Ellipsis" />
      <horizontal preferred-width="92" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="2" horizontal-fit="Unconstrained" vertical-fit="Unconstrained" preferred-height="8" child-expand-width="false">
        <text text="Open saved preset" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-width="30" preferred-height="8" />
        <dropdown-list-setting text="" value="ProjectChoice" apply-on-change="true" bind-value="true" preferred-width="60.0" preferred-height="8" id="project-list" choices="ProjectOptions" />
      </horizontal>
      <horizontal preferred-width="92" preferred-height="7" spacing="1" child-control-width="true" child-control-height="true" child-expand-width="false">
        <button text="Load preset" on-click="OpenProject" preferred-width="45.5" preferred-height="7" />
        <button text="Close" on-click="CloseLibrary" preferred-width="45.5" preferred-height="7" />
      </horizontal>
      <horizontal preferred-width="92" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="2" horizontal-fit="Unconstrained" vertical-fit="Unconstrained" preferred-height="8" child-expand-width="false">
        <text text="Current preset name" preferred-width="30" preferred-height="8" font-size="3.4" word-wrapping="false" overflow-mode="Ellipsis" />
        <string-setting text="" value="ProjectName" bind-value="true" apply-on-change="true" preferred-width="60.0" preferred-height="8" />
      </horizontal>
      <horizontal preferred-width="92" preferred-height="7" spacing="1" child-control-width="true" child-control-height="true" child-expand-width="false">
        <button text="Save a copy" on-click="SaveCopy" preferred-width="45.5" preferred-height="7" />
        <button text="Refresh list" on-click="RefreshFiles" preferred-width="45.5" preferred-height="7" />
      </horizontal>
    </vertical>
  </modal>
  <modal id="part-dialog" size-delta="102 66" click-off-closes="false" move-to-center="false">
    <vertical preferred-width="98" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" pad="3">
      <text text="ADD PART" preferred-width="92" preferred-height="7" font-size="4.5" word-wrapping="false" overflow-mode="Ellipsis" />
      <horizontal preferred-width="92" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="2" horizontal-fit="Unconstrained" vertical-fit="Unconstrained" preferred-height="8" child-expand-width="false">
        <text text="Part type" preferred-width="30" preferred-height="8" font-size="3.4" word-wrapping="false" overflow-mode="Ellipsis" />
        <dropdown-list-setting text="" value="NewPartType" choices="PartTypes" bind-value="true" apply-on-change="true" preferred-width="60.0" preferred-height="8" />
      </horizontal>
      <horizontal preferred-width="92" preferred-height="7" spacing="1" child-control-width="true" child-control-height="true" child-expand-width="false">
        <button text="Add" on-click="CreateChosenPart" preferred-width="45.5" preferred-height="7" />
        <button text="Cancel" on-click="ClosePartDialog" preferred-width="45.5" preferred-height="7" />
      </horizontal>
    </vertical>
  </modal>
  <modal id="number-dialog" size-delta="78 100" click-off-closes="false" move-to-center="false">
    <vertical preferred-width="74" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" pad="2">
      <text text="~NumberTitle" preferred-width="70" preferred-height="7" font-size="4.5" word-wrapping="false" overflow-mode="Ellipsis" />
      <text text="~NumberText" preferred-width="70" preferred-height="10" font-size="6" word-wrapping="false" overflow-mode="Ellipsis" />
      <text text="~NumberError" preferred-width="70" preferred-height="4" font-size="3.2" word-wrapping="false" overflow-mode="Ellipsis" />
      <horizontal preferred-width="70" preferred-height="10" spacing="2" child-control-width="true" child-control-height="true" child-expand-width="false">
        <button text="7" on-click="Num7" preferred-width="22" preferred-height="10" />
        <button text="8" on-click="Num8" preferred-width="22" preferred-height="10" />
        <button text="9" on-click="Num9" preferred-width="22" preferred-height="10" />
      </horizontal>
      <horizontal preferred-width="70" preferred-height="10" spacing="2" child-control-width="true" child-control-height="true" child-expand-width="false">
        <button text="4" on-click="Num4" preferred-width="22" preferred-height="10" />
        <button text="5" on-click="Num5" preferred-width="22" preferred-height="10" />
        <button text="6" on-click="Num6" preferred-width="22" preferred-height="10" />
      </horizontal>
      <horizontal preferred-width="70" preferred-height="10" spacing="2" child-control-width="true" child-control-height="true" child-expand-width="false">
        <button text="1" on-click="Num1" preferred-width="22" preferred-height="10" />
        <button text="2" on-click="Num2" preferred-width="22" preferred-height="10" />
        <button text="3" on-click="Num3" preferred-width="22" preferred-height="10" />
      </horizontal>
      <horizontal preferred-width="70" preferred-height="10" spacing="2" child-control-width="true" child-control-height="true" child-expand-width="false">
        <button text="-" on-click="NumSign" preferred-width="22" preferred-height="10" />
        <button text="0" on-click="Num0" preferred-width="22" preferred-height="10" />
        <button text="." on-click="NumDot" preferred-width="22" preferred-height="10" />
      </horizontal>
      <horizontal preferred-width="70" preferred-height="7" spacing="2" child-control-width="true" child-control-height="true" child-expand-width="false">
        <button text="Back" on-click="NumBack" preferred-width="34" preferred-height="7" />
        <button text="Clear" on-click="NumClear" preferred-width="34" preferred-height="7" />
      </horizontal>
      <horizontal preferred-width="70" preferred-height="8" spacing="2" child-control-width="true" child-control-height="true" child-expand-width="false">
        <button text="Apply" on-click="ApplyNumber" preferred-width="34" preferred-height="8" />
        <button text="Cancel" on-click="CloseNumber" preferred-width="34" preferred-height="8" />
      </horizontal>
    </vertical>
  </modal>
</vertical>
