          </horizontal>
          <vertical preferred-width="44.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
            <text text="X · mm" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
            <increment-setting text="" value="PositionX" min="-1000" max="1000" increment="1" apply-on-change="true" bind-value="true" preferred-height="6.4" preferred-width="44" />
          </vertical>
          <vertical preferred-width="44.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
            <text text="Y · mm" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
            <increment-setting text="" value="PositionY" min="-1000" max="1000" increment="1" apply-on-change="true" bind-value="true" preferred-height="6.4" preferred-width="44" />
          </vertical>
          <vertical preferred-width="44.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
            <text text="Z · mm" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
            <increment-setting text="" value="PositionZ" min="-1000" max="2000" increment="1" apply-on-change="true" bind-value="true" preferred-height="6.4" preferred-width="44" />
          </vertical>
          <vertical preferred-width="44.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
            <text text="Rotate X" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
            <increment-setting text="" value="RotationX" min="-360" max="360" increment="1" apply-on-change="true" bind-value="true" preferred-height="6.4" preferred-width="44" />
          </vertical>
          <vertical preferred-width="44.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
            <text text="Rotate Y" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
            <increment-setting text="" value="RotationY" min="-360" max="360" increment="1" apply-on-change="true" bind-value="true" preferred-height="6.4" preferred-width="44" />
          </vertical>
          <vertical preferred-width="44.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
            <text text="Rotate Z" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="44.0" />
            <increment-setting text="" value="RotationZ" min="-360" max="360" increment="1" apply-on-change="true" bind-value="true" preferred-height="6.4" preferred-width="44" />
          </vertical>
          <vertical active="~IsProfile" preferred-width="48" child-control-height="true" child-control-width="true" spacing="1" child-expand-height="false" vertical-fit="PreferredSize" horizontal-fit="Unconstrained">
