              <vertical preferred-width="94" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" active="~IsSolidPart">
                <horizontal preferred-width="94" preferred-height="6.4" spacing="0" child-control-width="true" child-control-height="true" child-expand-width="false">
