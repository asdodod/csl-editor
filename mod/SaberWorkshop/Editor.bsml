                  <bool-setting text="" value="ShowShapeDetails" bind-value="true" apply-on-change="true" preferred-width="18" preferred-height="6.4" />
                </horizontal>
                <vertical preferred-width="94" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" horizontal-fit="Unconstrained" vertical-fit="PreferredSize" active="~ShowShapeDetails">
