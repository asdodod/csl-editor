<vertical preferred-width="250" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" anchor-min="0 0" anchor-max="1 1" size-delta="0 0" horizontal-fit="Unconstrained" pad-top="1" pad-bottom="1" vertical-fit="Unconstrained" pivot="0.5 0.5" anchored-position="0 0">
  <horizontal preferred-width="250" preferred-height="12" spacing="1" child-control-width="true" child-control-height="true" child-expand-width="false">
    <button text="Create new preset" on-click="CreatePreset" preferred-width="56" preferred-height="9" />
    <vertical preferred-width="42.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
      <text text="Preset" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="42.0" />
      <string-setting text="" value="ProjectName" apply-on-change="true" bind-value="true" preferred-width="42" preferred-height="6.4" />
    </vertical>
    <button text="Save" on-click="Save" preferred-width="20" preferred-height="9" />
    <button text="Export CSL" on-click="ExportCSL" preferred-width="30" preferred-height="9" />
    <button text="Undo" on-click="Undo" preferred-width="16" preferred-height="9" />
    <button text="Redo" on-click="Redo" preferred-width="16" preferred-height="9" />
    <button text="Reset panel" on-click="RecenterWall" preferred-width="28" preferred-height="9" />
    <button text="Close" on-click="CloseEditor" preferred-width="22" preferred-height="9" />
  </horizontal>
  <horizontal preferred-width="250" preferred-height="104" spacing="2.5" child-control-width="true" child-control-height="true" child-expand-width="false">
    <vertical preferred-width="54" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" preferred-height="104" child-alignment="UpperCenter">
      <text text="PROJECT / PARTS" font-size="3.2" align="Center" preferred-width="54" preferred-height="5" word-wrapping="false" />
      <scroll-view preferred-width="54" preferred-height="43">
        <vertical preferred-width="50" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" vertical-fit="PreferredSize" horizontal-fit="Unconstrained">
          <vertical preferred-width="50.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
            <text text="New name" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="50.0" />
            <string-setting text="" value="NewPresetName" apply-on-change="true" bind-value="true" preferred-width="50" preferred-height="6.4" />
          </vertical>
          <vertical preferred-width="50.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
            <text text="Start with" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="50.0" />
            <dropdown-list-setting text="" value="StarterChoice" apply-on-change="true" bind-value="true" preferred-width="50" preferred-height="6.4" choices="StarterOptions" />
          </vertical>
          <vertical preferred-width="50.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
            <text text="Saved preset" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="50.0" />
            <dropdown-list-setting text="" value="ProjectChoice" apply-on-change="true" bind-value="true" preferred-width="50" preferred-height="6.4" choices="ProjectOptions" id="project-list" />
          </vertical>
          <horizontal preferred-width="50" preferred-height="7" spacing="2" child-control-width="true" child-control-height="true" child-expand-width="false">
            <button text="Open" on-click="OpenProject" preferred-width="24.0" preferred-height="7" />
            <button text="Save copy" on-click="SaveCopy" preferred-width="24.0" preferred-height="7" />
          </horizontal>
        </vertical>
      </scroll-view>
      <list id="part-tree" list-style="Simple" select-cell="SelectTreePart" list-width="54" visible-cells="6" cell-size="5" show-scrollbar="true" preferred-height="30" />
      <horizontal preferred-width="54" preferred-height="7" spacing="2" child-control-width="true" child-control-height="true" child-expand-width="false">
        <button text="Show / hide" on-click="TogglePart" preferred-width="26.0" preferred-height="7" />
        <button text="Copy" on-click="DuplicatePart" preferred-width="26.0" preferred-height="7" />
      </horizontal>
      <horizontal preferred-width="54" preferred-height="7" spacing="2" child-control-width="true" child-control-height="true" child-expand-width="false">
        <button text="+ Blade" on-click="AddBlade" preferred-width="26.0" preferred-height="7" />
        <button text="+ Handle" on-click="AddHandle" preferred-width="26.0" preferred-height="7" />
      </horizontal>
      <horizontal preferred-width="54" preferred-height="7" spacing="2" child-control-width="true" child-control-height="true" child-expand-width="false">
        <button text="+ Outline" on-click="AddOutline" preferred-width="26.0" preferred-height="7" />
        <button text="Delete" on-click="DeletePart" preferred-width="26.0" preferred-height="7" />
      </horizontal>
    </vertical>
    <vertical preferred-width="52" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" preferred-height="104" child-alignment="UpperCenter">
      <text text="SHAPE" font-size="3.2" align="Center" preferred-width="52" preferred-height="5" word-wrapping="false" />
      <scroll-view preferred-width="52" preferred-height="97">
        <vertical preferred-width="48" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" vertical-fit="PreferredSize" horizontal-fit="Unconstrained">
          <vertical preferred-width="50.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
            <text text="Part name" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="50.0" />
            <string-setting text="" value="PartName" apply-on-change="true" bind-value="true" preferred-width="50" preferred-height="6.4" />
          </vertical>
          <horizontal preferred-width="44" preferred-height="7" spacing="2" child-control-width="true" child-control-height="true" child-expand-width="false">
            <button text="+ Ring" on-click="AddRing" preferred-width="21.0" preferred-height="7" />
            <button text="+ Profile" on-click="AddProfile" preferred-width="21.0" preferred-height="7" />
          </horizontal>
          <horizontal preferred-width="44" preferred-height="7" spacing="2" child-control-width="true" child-control-height="true" child-expand-width="false">
            <button text="+ Inner" on-click="AddInner" preferred-width="44.0" preferred-height="7" />
          </horizontal>
          <vertical active="~IsCreatedPart" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="1" vertical-fit="PreferredSize" horizontal-fit="Unconstrained" preferred-width="48">
            <horizontal preferred-width="50.0" preferred-height="6.4" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" child-expand-width="false">
              <text text="Inverted faces" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="6.4" preferred-width="33.0" />
              <bool-setting text="" value="InvertedFaces" apply-on-change="true" bind-value="true" preferred-width="17" preferred-height="6.4" />
            </horizontal>
            <vertical preferred-width="50.0" preferred-height="10" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" vertical-fit="PreferredSize">
              <text text="Outline · mm" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="3.6" preferred-width="50.0" />
              <increment-setting text="" value="OutlineWidth" apply-on-change="true" bind-value="true" preferred-width="50" preferred-height="6.4" min="0" max="50" increment="0.1" />
            </vertical>
          </vertical>
          <horizontal preferred-width="44.0" preferred-height="6.4" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" child-expand-width="false">
            <text text="Link hands" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="6.4" preferred-width="27.0" />
            <bool-setting text="" value="LinkHands" apply-on-change="true" preferred-height="6.4" preferred-width="17" />
          </horizontal>
          <horizontal preferred-width="44.0" preferred-height="6.4" child-control-height="true" child-control-width="true" child-expand-height="false" spacing="0" horizontal-fit="Unconstrained" child-expand-width="false">
            <text text="Visible" font-size="3" align="Left" word-wrapping="false" overflow-mode="Overflow" preferred-height="6.4" preferred-width="27.0" />
